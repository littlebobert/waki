{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": "custom-worker.ts",
  "name": "waki",
  "compatibility_date": "2026-07-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "waki-database",
      "database_id": "1363f06d-9741-473b-8938-bf77103c28fa",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ATTENDEE_VIDEO_STREAM",
        "class_name": "AttendeeVideoStream"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AttendeeVideoStream"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
