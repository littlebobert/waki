HOST=127.0.0.1
PORT=3000
WORKER_POLL_INTERVAL_MS=500
DATABASE_PATH=./data/waki.sqlite

# Provider credentials. Keep these server-side.
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-plus

DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=us

QODER_PERSONAL_ACCESS_TOKEN=

# Optional local-image override for `pnpm baseline:live`.
# BASELINE_IMAGE_PATH=/absolute/path/to/hackathon-teams.png

# Bot authentication is disabled for the hackathon. Enable it only if needed.
BOT_AUTH_ENABLED=false
# BOT_API_TOKEN=

# Optional callback signing. Leave empty when the hackathon bot does not verify it.
WEBHOOK_SIGNING_SECRET=

# Comma-separated callback origins; this is an SSRF safety boundary, not bot auth.
BOT_CALLBACK_ALLOWED_ORIGINS=http://127.0.0.1:4100,http://localhost:4100
