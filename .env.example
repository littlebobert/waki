# Optional. Without this key, Waki uses its deterministic demo generator.
DASHSCOPE_API_KEY=
# International (Singapore) endpoint. Change this to your Model Studio region or workspace endpoint.
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-plus

# Hosted Attendee meeting bot integration.
ATTENDEE_API_KEY=
# Base64 secret from Attendee Settings > Webhooks.
ATTENDEE_WEBHOOK_SECRET=
# Public deployment origin used for bot-level webhook subscriptions.
WAKI_PUBLIC_URL=https://your-waki-worker.example.com
